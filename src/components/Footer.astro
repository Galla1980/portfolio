---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getLangFromUrl, routes, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const links = [
  { href: `${routes.home[lang]}#perfil`, label: t('nav.profile') },
  { href: `${routes.home[lang]}#proyectos`, label: t('nav.projects') },
  { href: `${routes.home[lang]}#trayectoria`, label: t('nav.track') },
  { href: routes.contact[lang], label: t('nav.contact') },
];
---

<footer class="mt-10 border-t border-line/70">
  <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2">
      <a href={routes.home[lang]} class="flex items-center gap-3">
        <span class="grid h-9 w-9 place-items-center rounded-xl border border-line bg-bg text-[13px] font-semibold tracking-tight text-ink">
          {site.initials}
        </span>
        <span class="flex flex-col leading-tight">
          <span class="text-sm font-semibold">{site.name}</span>
          <span class="font-mono text-[10px] tracking-[0.1em] text-muted uppercase">{t('footer.tagline')}</span>
        </span>
      </a>
    </div>

    <div>
      <h2 class="label">{t('footer.nav')}</h2>
      <ul class="mt-4 space-y-2.5">
        {links.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-muted transition hover:text-accent">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="label">{t('footer.channels')}</h2>
      <ul class="mt-4 space-y-2.5">
        <li>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 text-sm text-muted transition hover:text-accent"
          >
            <Icon name="mail" size={15} />
            Correo
          </a>
        </li>
        <li>
          <a
            href={site.github}
            target="_blank"
            rel="me noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm text-muted transition hover:text-accent"
          >
            <Icon name="github" size={15} />
            GitHub
          </a>
        </li>
        <li>
          <a
            href={site.linkedin}
            target="_blank"
            rel="me noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm text-muted transition hover:text-accent"
          >
            <Icon name="linkedin" size={15} />
            LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line/70">
    <div
      class="container-page flex flex-col items-start justify-between gap-3 py-5 text-[11px] text-muted sm:flex-row sm:items-center"
    >
      <p class="font-mono">© {year} {site.name} · {t('footer.rights')}</p>
      <div class="flex items-center gap-4 font-mono">
        <span>{t('footer.stack')}</span>
        <a href="#main" class="inline-flex items-center gap-1.5 transition hover:text-accent" aria-label={t('a11y.toTop')}>
          <Icon name="arrow-up" size={13} />
        </a>
      </div>
    </div>
  </div>
</footer>

---
import Icon from './Icon.astro';
import { hasCaseStudy } from '../data/cases';
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';
import { routes, useTranslations } from '../i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
  variant?: 'feature' | 'compact';
  index?: number;
}

const { project, lang, variant = 'compact', index = 0 } = Astro.props;
const isFeature = variant === 'feature';
const t = useTranslations(lang);
const repoLabel = project.repo?.replace('https://github.com/', '') ?? '';
const caseHref = hasCaseStudy(project.slug) ? `${routes.caseStudies[lang]}/${project.slug}` : null;
---

<article
  class:list={[
    'glass card-hover flex h-full flex-col',
    isFeature ? 'gap-6 p-7 sm:p-9' : 'gap-4 p-5',
  ]}
  data-reveal
  style={`--reveal-delay: ${index * 80}ms`}
>
  <div class="flex items-start justify-between gap-4">
    <span class="label">{project.context[lang]}</span>
    <span class="font-mono text-[12px] whitespace-nowrap text-muted">{project.year}</span>
  </div>

  {isFeature ? (
    <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="flex flex-col gap-5">
        <div>
          <h3 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{project.title[lang]}</h3>
          <p class="mt-2 max-w-2xl text-[1rem] leading-relaxed text-muted">{project.summary[lang]}</p>
        </div>

        <ul class="flex flex-wrap gap-1.5">
          {project.stack.map((item) => <li class="chip">{item}</li>)}
        </ul>
      </div>

      {project.image && (
        <figure>
          <img
            src={project.image.src}
            alt={project.image.alt[lang]}
            width="512"
            height="307"
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl border border-line/80 bg-surface-2/40"
          />
        </figure>
      )}
    </div>
  ) : (
    <>
      <div>
        <h3 class="text-base leading-snug font-semibold tracking-tight text-ink">{project.title[lang]}</h3>
        <p class="mt-2 text-[14px] leading-relaxed text-muted">{project.summary[lang]}</p>
      </div>

      <ul class="mt-auto flex flex-wrap gap-1.5 border-t border-line/60 pt-4">
        {project.stack.slice(0, 3).map((item) => <li class="chip">{item}</li>)}
      </ul>
    </>
  )}

  {isFeature && (
    <ul class="grid gap-2.5 border-t border-line/70 pt-6 sm:grid-cols-2">
      {project.highlights[lang].map((item) => (
        <li class="flex items-start gap-2.5 text-[14px] leading-snug text-muted">
          <Icon name="check" size={15} class="mt-0.5 shrink-0 text-accent" />
          {item}
        </li>
      ))}
    </ul>
  )}

  {(caseHref || project.repo) && (
    <div
      class:list={[
        'flex flex-wrap items-center gap-x-6 gap-y-3',
        isFeature && 'border-t border-line/70 pt-5',
      ]}
    >
      {caseHref && (
        <a
          href={caseHref}
          class="inline-flex items-center gap-2 text-[14px] font-medium text-accent transition hover:gap-3"
        >
          {t('work.more')}
          <Icon name="arrow-right" size={15} />
        </a>
      )}

      {project.repo && (
        <a
          href={project.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 text-[14px] text-muted transition hover:text-accent"
        >
          <Icon name="github" size={16} class="shrink-0 text-accent" />
          <span class="font-medium">{t('work.repo')}</span>
          {isFeature && repoLabel && <span class="truncate font-mono text-[12px]">{repoLabel}</span>}
        </a>
      )}
    </div>
  )}
</article>

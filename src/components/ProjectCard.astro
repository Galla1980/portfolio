---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
  variant?: 'feature' | 'compact';
  index?: number;
}

const { project, lang, variant = 'compact', index = 0 } = Astro.props;
const isFeature = variant === 'feature';
const t = useTranslations(lang);
const repoLabel = project.repo?.replace('https://github.com/', '') ?? '';
---

<article
  class:list={[
    'glass card-hover flex h-full flex-col',
    isFeature ? 'gap-6 p-7 sm:p-9' : 'gap-4 p-5',
  ]}
  data-reveal
  style={`--reveal-delay: ${index * 80}ms`}
>
  <div class="flex items-start justify-between gap-4">
    <span class="label">{project.context[lang]}</span>
    <span class="font-mono text-[11px] whitespace-nowrap text-muted">{project.year}</span>
  </div>

  {isFeature ? (
    <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="flex flex-col gap-5">
        <div>
          <h3 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{project.title[lang]}</h3>
          <p class="mt-2 max-w-2xl text-[0.95rem] leading-relaxed text-muted">{project.summary[lang]}</p>
        </div>

        <ul class="flex flex-wrap gap-1.5">
          {project.stack.map((item) => <li class="chip">{item}</li>)}
        </ul>
      </div>

      {project.image && (
        <figure>
          <img
            src={project.image.src}
            alt={project.image.alt[lang]}
            width="512"
            height="307"
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl border border-line/80 bg-surface-2/40"
          />
        </figure>
      )}
    </div>
  ) : (
    <>
      <div>
        <h3 class="text-base leading-snug font-semibold tracking-tight text-ink">{project.title[lang]}</h3>
        <p class="mt-2 text-[13px] leading-relaxed text-muted">{project.summary[lang]}</p>
      </div>

      {project.image && (
        <figure class="w-full">
          <img
            src={project.image.src}
            alt={project.image.alt[lang]}
            width="512"
            height="307"
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl border border-line/80 bg-surface-2/40"
          />
        </figure>
      )}

      <ul class="mt-auto flex flex-wrap gap-1.5 border-t border-line/60 pt-4">
        {project.stack.slice(0, 3).map((item) => <li class="chip">{item}</li>)}
      </ul>
    </>
  )}

  {isFeature && (
    <ul class="grid gap-2.5 border-t border-line/70 pt-6 sm:grid-cols-2">
      {project.highlights[lang].map((item) => (
        <li class="flex items-start gap-2.5 text-[13px] leading-snug text-muted">
          <Icon name="check" size={15} class="mt-0.5 shrink-0 text-accent" />
          {item}
        </li>
      ))}
    </ul>
  )}

  {project.repo && (
    <a
      href={project.repo}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'flex items-center gap-2.5 text-[13px] text-muted transition hover:text-accent',
        isFeature && 'border-t border-line/70 pt-5',
      ]}
    >
      <Icon name="github" size={16} class="shrink-0 text-accent" />
      <span class="font-medium">{t('work.repo')}</span>
      {isFeature && repoLabel && <span class="ml-auto truncate font-mono text-[11px]">{repoLabel}</span>}
    </a>
  )}
</article>

---
interface Props {
  num: string;
  label: string;
  note?: string;
}

const { num, label, note } = Astro.props;
---

<div class="section-head" data-reveal>
  <span class="section-num">{num}</span>
  <span class="section-rule"></span>
</div>

<h2 class="mt-7 text-2xl font-semibold tracking-tight text-ink sm:text-[2rem]" data-reveal style="--reveal-delay: 60ms">
  {label}
</h2>

{note && (
  <p class="mt-3 max-w-2xl leading-relaxed text-muted" data-reveal style="--reveal-delay: 120ms">
    {note}
  </p>
)}

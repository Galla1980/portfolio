---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import { site } from '../data/site';
import { getLangFromUrl, routes, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = routes.home[lang];

const links = [
  { href: `${home}#perfil`, label: t('nav.profile') },
  { href: `${home}#proyectos`, label: t('nav.projects') },
  { href: `${home}#trayectoria`, label: t('nav.track') },
];
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-bg/60 backdrop-blur-md transition-colors duration-300"
>
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <a href={home} class="flex items-center gap-3">
      <span aria-hidden="true" class="rounded-xl bg-gradient-to-br from-accent to-accent-2 p-[1.5px]">
        <span
          class="grid h-[33px] w-[33px] place-items-center rounded-[10.5px] bg-bg text-[13px] font-semibold tracking-tight text-ink"
        >
          {site.initials}
        </span>
      </span>
      <span class="hidden flex-col leading-snug sm:flex">
        <span class="text-sm font-semibold tracking-tight">{site.name}</span>
        <span class="font-mono text-[11px] tracking-[0.1em] text-muted uppercase">.net developer</span>
      </span>
      <span class="sr-only sm:hidden">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={t('nav.main')}>
      {links.map((link) => (
        <a
          href={link.href}
          class="rounded-full px-3 py-2 text-[14px] text-muted transition hover:bg-surface-2/60 hover:text-ink"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <LangToggle />
      <ThemeToggle />
      <a href={site.cv[lang]} class="icon-btn" download aria-label={t('nav.cv')}>
        <Icon name="download" size={16} />
      </a>
      <a href={routes.contact[lang]} class="btn btn-primary hidden h-9 px-4 text-[14px] sm:inline-flex">
        {t('nav.contact')}
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="icon-btn md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('a11y.menu')}
        data-label-open={t('a11y.menu')}
        data-label-close={t('a11y.menu.close')}
      >
        <Icon name="menu" class="icon-menu" size={18} />
        <Icon name="close" class="icon-close" size={18} />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden" hidden>
    <nav class="container-page flex flex-col gap-1 border-t border-line py-4" aria-label={t('nav.main')}>
      {links.map((link) => (
        <a
          href={link.href}
          class="rounded-xl px-3 py-3 text-base text-muted transition hover:bg-surface-2/60 hover:text-ink"
        >
          {link.label}
        </a>
      ))}
      <a href={site.cv[lang]} class="btn btn-ghost mt-2 w-full" download>
        <Icon name="download" size={16} />
        {t('nav.cv')}
      </a>
    </nav>
  </div>
</header>

<style>
  #mobile-menu-toggle[aria-expanded='true'] .icon-menu {
    display: none;
  }

  #mobile-menu-toggle[aria-expanded='false'] .icon-close {
    display: none;
  }
</style>

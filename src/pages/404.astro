---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { routes, useTranslations } from '../i18n/utils';

const t = useTranslations('es');
---

<BaseLayout title={t('notfound.title')} noindex>
  <section class="relative overflow-hidden">
    <div class="aurora" aria-hidden="true"></div>
    <div class="container-page relative flex flex-col items-center py-24 text-center">
      <p class="font-mono text-6xl font-semibold text-accent sm:text-7xl">404</p>
      <h1 class="mt-6 text-2xl font-semibold tracking-tight sm:text-3xl">{t('notfound.title')}</h1>
      <p class="mt-3 max-w-md text-muted">{t('notfound.lead')}</p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={routes.home.es} class="btn btn-primary">
          <Icon name="arrow-left" size={16} />
          {t('notfound.home')}
        </a>
        <a href={routes.home.en} class="btn btn-ghost" lang="en" hreflang="en" title="English version">
          <Icon name="globe" size={16} />
          English version
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

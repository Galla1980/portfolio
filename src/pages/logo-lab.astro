---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site } from '../data/site';

const variants = [
  {
    n: '00',
    label: 'Actual (A)',
    desc: 'Caja con borde fino, sin degradé',
    mark: `<span class="grid h-9 w-9 place-items-center rounded-xl border border-line bg-bg text-[13px] font-semibold tracking-tight text-ink">LG</span>`,
  },
  {
    n: '01',
    label: 'Tipográfico suelto',
    desc: 'Sin caja: solo las iniciales, como firma',
    mark: `<span class="text-[15px] font-semibold tracking-tight text-ink">LG</span>`,
  },
  {
    n: '02',
    label: 'Monoespaciado en caja',
    desc: 'Caja con borde y JetBrains Mono, guiño técnico',
    mark: `<span class="grid h-9 w-9 place-items-center rounded-xl border border-line bg-bg font-mono text-[12px] font-bold tracking-tighter text-ink">LG</span>`,
  },
  {
    n: '03',
    label: 'Iniciales con punto',
    desc: 'L·G con el punto en color de acento',
    mark: `<span class="text-[15px] font-semibold tracking-tight text-ink">L<span class="text-accent">·</span>G</span>`,
  },
  {
    n: '04',
    label: 'Isotipo de capas',
    desc: 'Tres barras escalonadas: deja de ser monograma',
    mark: `<span class="flex h-9 w-9 flex-col items-start justify-center gap-[3px] rounded-xl border border-line bg-bg px-2.5">
      <span class="h-[3px] w-4 rounded-full bg-accent"></span>
      <span class="h-[3px] w-3 rounded-full bg-accent/65"></span>
      <span class="h-[3px] w-2 rounded-full bg-accent/40"></span>
    </span>`,
  },
  {
    n: '05',
    label: 'Borde degradé',
    desc: 'El degradé solo en el contorno, letras en tinta',
    mark: `<span class="rounded-xl bg-gradient-to-br from-accent to-accent-2 p-[1.5px]">
      <span class="grid h-9 w-9 place-items-center rounded-[10.5px] bg-bg text-[13px] font-semibold tracking-tight text-ink">LG</span>
    </span>`,
  },
  {
    n: '06',
    label: 'Caja invertida',
    desc: 'Sin degradé: bloque lleno con las letras recortadas',
    mark: `<span class="grid h-9 w-9 place-items-center rounded-xl bg-ink text-[13px] font-semibold tracking-tight text-bg">LG</span>`,
  },
  {
    n: '07',
    label: 'Corchetes',
    desc: 'Lectura de código, corchetes en acento',
    mark: `<span class="font-mono text-[13px] font-semibold tracking-tighter text-ink"><span class="text-accent">[</span>LG<span class="text-accent">]</span></span>`,
  },
  {
    n: '08',
    label: 'Inicial única',
    desc: 'Una sola letra, más limpio a tamaño chico',
    mark: `<span class="grid h-9 w-9 place-items-center rounded-xl border border-line bg-surface text-[15px] font-semibold text-ink">L</span>`,
  },
  {
    n: '09',
    label: 'Degradé en las letras',
    desc: 'Caja neutra y las iniciales con el degradé',
    mark: `<span class="grid h-9 w-9 place-items-center rounded-xl border border-line bg-bg"><span class="grad-text text-[13px] font-semibold tracking-tight">LG</span></span>`,
  },
];

const bloques = [
  { id: 'bloque-a', items: variants.slice(0, 5) },
  { id: 'bloque-b', items: variants.slice(5) },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Variantes de logo · Lucas Gallardo</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-bg text-ink">
    <div class="mx-auto max-w-[1120px] px-8 py-12">
      <p class="label">Laboratorio interno</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Variantes de logo</h1>
      <p class="mt-2 text-sm text-muted">
        Cada variante en tamaño real (36 px, como el header) y ampliada 2,2× para ver el detalle, sobre fondo oscuro y
        claro. El bloque 00 es el que está hoy en el sitio.
      </p>

      {bloques.map((bloque) => (
        <div class="mt-10 grid gap-5" id={bloque.id}>
          {bloque.items.map((v) => (
            <article class="overflow-hidden rounded-2xl border border-line">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line bg-surface/60 px-5 py-3">
                <span class="font-mono text-[11px] text-accent">{v.n}</span>
                <h2 class="text-sm font-semibold">{v.label}</h2>
                <p class="text-xs text-muted">{v.desc}</p>
              </div>

              <div class="grid sm:grid-cols-2">
                <div class="flex items-center justify-between gap-6 bg-[#0a0908] px-6 py-6" data-theme="dark">
                  <div class="flex items-center gap-3">
                    <Fragment set:html={v.mark} />
                    <span class="flex flex-col leading-tight">
                      <span class="text-sm font-semibold text-ink">{site.name}</span>
                      <span class="font-mono text-[10px] tracking-[0.1em] text-muted uppercase">.net developer</span>
                    </span>
                  </div>
                  <span class="grid h-[96px] w-[96px] shrink-0 place-items-center overflow-hidden">
                    <span class="scale-[2.2]"><Fragment set:html={v.mark} /></span>
                  </span>
                </div>

                <div class="flex items-center justify-between gap-6 bg-[#faf8f6] px-6 py-6" data-theme="light">
                  <div class="flex items-center gap-3">
                    <Fragment set:html={v.mark} />
                    <span class="flex flex-col leading-tight">
                      <span class="text-sm font-semibold text-ink">{site.name}</span>
                      <span class="font-mono text-[10px] tracking-[0.1em] text-muted uppercase">.net developer</span>
                    </span>
                  </div>
                  <span class="grid h-[96px] w-[96px] shrink-0 place-items-center overflow-hidden">
                    <span class="scale-[2.2]"><Fragment set:html={v.mark} /></span>
                  </span>
                </div>
              </div>
            </article>
          ))}
        </div>
      ))}

      <div class="mt-8 grid gap-3 rounded-2xl border border-line p-5 text-xs text-muted">
        <p class="text-ink">Cosas a tener en cuenta al elegir</p>
        <p>El mismo símbolo tiene que funcionar a 16 px (favicon), 36 px (header y footer) y 56 px (imagen de Open Graph).</p>
        <p>También tiene que funcionar con las otras paletas (esmeralda y ciruela), que cambian el acento y el contraste.</p>
      </div>
    </div>
  </body>
</html>
